# Ollama local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Prévia interna das representações educativas MIRA (ativada por padrão)
MIRA_PREVIEW_ENABLED=1
# Define 0 para desativar somente a prévia de Clara Camarão
MIRA_CLARA_PREVIEW_ENABLED=1

# Fila do WhatsApp: ate 3 mensagens por conversa e pausa antes das seguintes
WHATSAPP_QUEUE_WORKERS=2
WHATSAPP_USER_BURST=3
WHATSAPP_USER_PAUSE_SECONDS=5
WHATSAPP_MAX_PENDING_PER_USER=30
WHATSAPP_MAX_PENDING_TOTAL=2000
WHATSAPP_STICKER_INTERVAL=5
# A cada quantas respostas dentro do tema o bot pode enviar uma imagem
# ilustrativa do assunto da conversa, alem do pedido explicito de imagem
WHATSAPP_IMAGE_INTERVAL=5
